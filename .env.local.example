# ── كوب — frontend ─────────────────────────────────────────────────────────
# cp .env.local.example .env.local
# Every NEXT_PUBLIC_* is a build arg with NO default. A missing one fails
# visibly instead of silently pointing this build at another deployment.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VERTICAL=cafe
NEXT_PUBLIC_SITE_MODE=store
# Which tenant plain localhost is. Without this the app thinks it is the
# central marketing site and bounces you to koup.localhost after login.
NEXT_PUBLIC_PHARMACY_SLUG=koup
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_BUILD_ID=local

# Clerk — customer sign-in with Google + Facebook
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Realtime cart sync (already used by the POS template)
NEXT_PUBLIC_CONVEX_URL=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Observability
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/970597020201

# Facebook sign-in. Clerk dev instances use Clerk"s shared Facebook app,
# which Meta has deactivated ("App not active"). Add custom Facebook
# credentials in the Clerk dashboard, then set this to "on".
# NEXT_PUBLIC_KOUP_FACEBOOK=on
